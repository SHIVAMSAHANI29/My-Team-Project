# Copy this file to ".env" and adjust. Placeholders only: never commit a real .env.
# ChronosMatch is a SIMULATOR. There are no brokerage keys or credentials here.

CHRONOS_HOST=127.0.0.1
CHRONOS_PORT=8000
CHRONOS_DB_PATH=chronosmatch.db
CHRONOS_LOG_LEVEL=INFO

# Request / abuse limits
CHRONOS_MAX_REQUEST_BYTES=16384
CHRONOS_RATE_LIMIT_PER_MINUTE=600

# WebSocket: per-client outgoing queue size (slow clients are dropped when full)
CHRONOS_WS_QUEUE_SIZE=100

# Default number of trades returned by the API when no limit is given
CHRONOS_DEFAULT_TRADE_LIMIT=50

# Runtime server and SQLite persistence
CHRONOS_HOST=127.0.0.1
CHRONOS_PORT=8000
CHRONOS_DB_PATH=chronosmatch.db
CHRONOS_LOG_LEVEL=INFO
